# Copy to .env and adjust.
DATABASE_URL=postgres://fctime:fctime@localhost:5432/fctime
PORT=3000
# Set to 1 behind HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=0
# Password given to every demo user by `npm run db:seed`.
DEMO_PASSWORD=fifthcolor-demo
# Behind a reverse proxy, how many proxy hops to trust for the client address (used by the sign-in limiter).
# TRUST_PROXY=1
