# Copy to .env and adjust.
DATABASE_URL=mysql://fctime:fctime@localhost:3306/fctime
PORT=3000
# Set to 1 behind HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=0
# Built-in admin login: username `admin`, with this password (at least 12 characters).
# Applied each time the server starts. Leave it unset for no such login.
# ADMIN_PASSWORD=
# Password given to every demo user by `npm run db:seed`.
DEMO_PASSWORD=fifthcolor-demo
# Behind a reverse proxy, how many proxy hops to trust for the client address (used by the sign-in limiter).
# TRUST_PROXY=1
